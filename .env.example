# Copy to .env and supply your own password (12+ characters).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
PORT=3000
# demo uses local JSON; sheets uses Google Sheets API.
DATA_MODE=demo
SPREADSHEET_ID=
# Absolute path to a service-account credential file; never commit it.
GOOGLE_APPLICATION_CREDENTIALS=
# Set production only behind HTTPS. Sessions are lost on server restart.
NODE_ENV=development
# GitHub Pages frontend origin (without /sibil or trailing slash).
FRONTEND_ORIGIN=https://egantc.github.io
# Set only for a hosting provider with exactly one trusted reverse-proxy hop.
# TRUST_PROXY_HOPS=1
